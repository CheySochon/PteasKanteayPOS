generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrderStatus {
  pending
  accepted
  preparing
  ready
  served
  completed
  cancelled
}

enum TableZone {
  indoor
  outdoor
  vip
}


enum NotificationType {
  new_order
  payment_completed
  order_status_updated
}

model Group {
  id               Int               @id @default(autoincrement())
  name             String            @unique
  description      String?
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")
  groupPermissions GroupPermission[]
  userGroups       UserGroup[]

  @@map("groups")
}

model Permission {
  id               Int               @id @default(autoincrement())
  code             String            @unique
  name             String
  description      String?
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")
  groupPermissions GroupPermission[]

  @@map("permissions")
}

model GroupPermission {
  groupId      Int        @map("group_id")
  permissionId Int        @map("permission_id")
  group        Group      @relation(fields: [groupId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([groupId, permissionId])
  @@index([permissionId])
  @@map("group_permissions")
}

model UserGroup {
  userId  Int   @map("user_id")
  groupId Int   @map("group_id")
  user    User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  group   Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([userId, groupId])
  @@index([groupId])
  @@map("user_groups")
}

model User {
  id                    Int                @id @default(autoincrement())
  name                  String
  email                 String             @unique
  password              String
  userGroups            UserGroup[]
  ordersCreated         Order[]            @relation("OrderCreatedBy")
  auditLogs             AuditLog[]
  stockTransactions     StockTransaction[]
  isActive              Boolean            @default(true)
  failedLoginAttempts   Int                @default(0)
  lockedUntil           DateTime?
  pin                   String?
  imageUrl              String?
  deletedAt             DateTime?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  @@index([isActive])
  @@index([deletedAt])
}

model AppSetting {
  id          Int      @id @default(autoincrement())
  key         String   @unique
  value       Json
  category    String   @default("general")
  description String?
  updatedById Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
}

model Category {
  id            Int       @id @default(autoincrement())
  name          String
  nameKm        String?   @map("name_km")
  slug          String    @unique
  description   String?
  descriptionKm String?   @map("description_km")
  imageUrl      String?   @map("image_url")
  products      Product[]
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([deletedAt])
}

model Product {
  id                 Int                  @id @default(autoincrement())
  categoryId         Int
  category           Category             @relation(fields: [categoryId], references: [id])
  supplierId         Int?                 @map("supplier_id")
  supplier           Supplier?            @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  name               String
  nameKm             String?              @map("name_km")
  slug               String               @unique
  description        String?
  descriptionKm      String?              @map("description_km")
  imageUrl           String?
  basePrice          Decimal              @db.Decimal(10, 2)
  isAvailable        Boolean              @default(true)
  prepTime           Int?                 @default(10)
  unit               String               @default("pc")
  trackStock         Boolean              @default(false)
  inventory          Inventory?
  orderItems         OrderItem[]
  stockTransactions  StockTransaction[]
  purchaseOrderItems PurchaseOrderItem[]
  deletedAt          DateTime?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  @@index([categoryId])
  @@index([supplierId])
  @@index([isAvailable])
  @@index([deletedAt])
}

model Supplier {
  id             Int             @id @default(autoincrement())
  name           String
  companyName    String?         @map("company_name")
  email          String?
  phone          String?
  address        String?
  notes          String?
  isActive       Boolean         @default(true) @map("is_active")
  products       Product[]
  purchaseOrders PurchaseOrder[]
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  @@map("suppliers")
}

model PurchaseOrder {
  id                   Int                 @id @default(autoincrement())
  poNumber             String              @unique @map("po_number")
  supplierId           Int                 @map("supplier_id")
  supplier             Supplier            @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  status               String              @default("ordered") // "draft", "ordered", "received", "cancelled"
  orderDate            DateTime            @default(now()) @map("order_date")
  expectedDeliveryDate DateTime?           @map("expected_delivery_date")
  totalAmount          Decimal             @default(0) @db.Decimal(10, 2) @map("total_amount")
  notes                String?
  createdById          Int?                @map("created_by_id")
  items                PurchaseOrderItem[]
  createdAt            DateTime            @default(now()) @map("created_at")
  updatedAt            DateTime            @updatedAt @map("updated_at")

  @@index([supplierId])
  @@index([status])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id              Int           @id @default(autoincrement())
  purchaseOrderId Int           @map("purchase_order_id")
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  productId       Int           @map("product_id")
  product         Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity        Decimal       @db.Decimal(10, 4)
  unitCost        Decimal       @db.Decimal(10, 2) @map("unit_cost")
  totalCost       Decimal       @db.Decimal(10, 2) @map("total_cost")

  @@index([purchaseOrderId])
  @@index([productId])
  @@map("purchase_order_items")
}

model DiningTable {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  capacity  Int
  zone      TableZone
  qrToken   String    @unique
  isActive  Boolean   @default(true)
  reservation String?
  orders    Order[]
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([zone])
  @@index([isActive])
  @@index([deletedAt])
}

model Order {
  id             Int             @id @default(autoincrement())
  orderNumber    String          @unique
  tableId        Int?
  table          DiningTable?    @relation(fields: [tableId], references: [id])
  createdById    Int?
  createdBy      User?           @relation("OrderCreatedBy", fields: [createdById], references: [id])
  status         OrderStatus     @default(pending)
  subtotal       Decimal         @default(0) @db.Decimal(10, 2)
  discountAmount Decimal         @default(0) @db.Decimal(10, 2)
  taxAmount      Decimal         @default(0) @db.Decimal(10, 2)
  totalAmount    Decimal         @default(0) @db.Decimal(10, 2)
  paymentMethod  String?         @default("cash")
  notes          String?
  items          OrderItem[]
  notifications  Notification[]
  deletedAt      DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([status, createdAt])
  @@index([deletedAt, createdAt])
  @@index([orderNumber])
  @@index([tableId])
  @@index([createdById])
  @@index([deletedAt])
}

model OrderItem {
  id         Int                 @id @default(autoincrement())
  orderId    Int
  order      Order               @relation(fields: [orderId], references: [id])
  productId  Int
  product    Product             @relation(fields: [productId], references: [id])
  quantity   Int
  unitPrice  Decimal             @db.Decimal(10, 2)
  totalPrice Decimal             @db.Decimal(10, 2)
  notes      String?
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  @@index([orderId])
  @@index([productId])
}




model Notification {
  id        Int              @id @default(autoincrement())
  type      NotificationType
  title     String
  message   String
  orderId   Int?
  order     Order?           @relation(fields: [orderId], references: [id])
  isSent    Boolean          @default(false)
  sentAt    DateTime?
  error     String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([type])
  @@index([orderId])
  @@index([isSent])
  @@index([createdAt])
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int?
  userName  String
  userRole  String
  action    String
  ipAddress String?
  userAgent String?
  status    String
  details   String?
  createdAt DateTime @default(now())

  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([status])
  @@index([createdAt])
  @@map("audit_logs")
}

model Inventory {
  id        Int      @id @default(autoincrement())
  productId Int      @unique
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Decimal  @default(0) @db.Decimal(10, 4)
  minStock  Decimal  @default(0) @db.Decimal(10, 4)
  updatedAt DateTime @updatedAt

  @@index([productId])
}

model StockTransaction {
  id          Int      @id @default(autoincrement())
  productId   Int
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  type        String   // "restock", "sale", "damage", "adjustment", "return", "expired"
  quantity    Decimal  @db.Decimal(10, 4)
  referenceId String?
  notes       String?
  userId      Int?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  @@index([productId])
  @@index([userId])
  @@index([createdAt])
}
